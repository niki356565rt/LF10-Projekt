@startuml
skinparam DefaultFontName Arial
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam NoteBackgroundColor #E8F8F5
skinparam NoteBorderColor #1ABC9C
' Kein "skinparam conditionStyle diamond": dieser Parameter unterdrueckt in
' PlantUML 1.2025.4 die Kantenbeschriftungen der repeat-while-Rauten.
' Die Standarddarstellung zeichnet Entscheidungen ohnehin als klassische Raute.

|Service|
start
:Tisch auswählen;

repeat
  :Bestellung (Nachbestellung) anlegen;

  repeat
    :Position hinzufügen;
    :Wunsch nach weiteren Positionen abfragen;
  repeat while (Weitere Positionen?) is ([Ja, weitere Position erfassen]) not ([Nein, Erfassung abgeschlossen])

  :Bestellung speichern;
  :Status -> aufgegeben;
  :Log(Status='aufgegeben', Mitarbeiter='', Zeit='', Bestellung='');
  note right: [Bestellstatus = aufgegeben]

  :Bestellpositionen nach Kategorie prüfen;

  if (Speisen enthalten?) then ([Ja, Speisen vorhanden])
    |Küche|
    :Bestellung in Küchenansicht anzeigen;
    :Status -> in Bearbeitung;
    :Log(Status='in Bearbeitung', Mitarbeiter='', Zeit='', Bestellung='');
    note right: [Bestellstatus = in Bearbeitung]
    :Speisen zubereiten;
    :Status -> fertig;
    :Log(Status='fertig', Mitarbeiter='', Zeit='', Bestellung='');
    note right: [Bestellstatus = fertig]
  else ([Nein, keine Speisen enthalten])
  endif

  |Service|
  if (Getränke enthalten?) then ([Ja, Getränke vorhanden])
    |Bar|
    :Bestellung in Baransicht anzeigen;
    :Status -> in Bearbeitung;
    :Log(Status='in Bearbeitung', Mitarbeiter='', Zeit='', Bestellung='');
    note right: [Bestellstatus = in Bearbeitung]
    :Getränke zubereiten;
    :Status -> fertig;
    :Log(Status='fertig', Mitarbeiter='', Zeit='', Bestellung='');
    note right: [Bestellstatus = fertig]
  else ([Nein, keine Getränke enthalten])
  endif

  |Service|
  :Speisen/Getränke servieren;
  :Status -> serviert;
  :Log(Status='serviert', Mitarbeiter='', Zeit='', Bestellung='');
  note right: [Bestellstatus = serviert]

  :Gästewunsch bezüglich Rechnung oder Nachbestellung erfragen;
repeat while (Rechnung erstellen?) is ([Nein, weitere Bestellung aufnehmen]) not ([Ja, Rechnung erstellen])

:Rechnung anzeigen;
:Bezahlung entgegennehmen;
:Status -> bezahlt;
:Log(Status='bezahlt', Mitarbeiter='', Zeit='', Bestellung='');
note right: [Bestellstatus = bezahlt]

:Tisch freigeben;

stop
@enduml
